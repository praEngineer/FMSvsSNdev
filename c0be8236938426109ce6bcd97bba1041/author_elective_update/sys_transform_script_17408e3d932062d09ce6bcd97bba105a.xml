        <order>100</order>
        <script><![CDATA[(function transformRow(source, target, map, log, isUpdate, isInsert) {
    // 'source' = Import Set row fields
    // 'target' = Target table record (may be unused if your main target is the procurement table)
    // 'map'    = Mappings
    // 'log'    = Logger
    // 'isUpdate' and 'isInsert' indicate if the target record is new/updated

    // 1. Grab the FMS "Enc Doc ID" from the import row
    var encDocId = source.u_enc_doc_id.toString();  // Adjust field names as needed

    // 2. Retrieve the "Acct Line Amount"
    var acctLineAmount = parseFloat(source.u_acct_line_amount) || 0;

    // 3. Use GlideRecord to find the matching record in the Procurement table
    var grProc = new GlideRecord('x_dosny_bit_procur_bit_procurement');
    grProc.addQuery('po_number', encDocId);
    grProc.query();

    if (grProc.next()) {
        // 4. Update the new fms_encumbered_amount field with the Acct Line Amount
        grProc.fms_encumbered_amount = acctLineAmount;

        // 5. Calculate the difference
        //    'encumbered' is presumably your existing field in the Procurement table
        var existingEnc = parseFloat(grProc.encumbered) || 0;
        var diff = acctLineAmount - existingEnc;

        // 6. Store the difference in sn_fms_encumbrance_diff
        grProc.sn_fms_encumbrance_diff = diff;

        // 7. Save
        grProc.update();
    }
    else {
        // Optional: If no match is found, log it
        log.info('No procurement record found for encDocId = ' + encDocId);
    }

})(source, target, map, log, isUpdate, isInsert);
]]></script>
